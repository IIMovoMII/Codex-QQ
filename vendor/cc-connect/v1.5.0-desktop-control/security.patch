+func (p *Platform) newPermissionToken(sessionKey, requestID string, contexts ...*replyContext) string {
+	var raw [9]byte
+	if _, err := rand.Read(raw[:]); err != nil {
+		copy(raw[:], []byte(requestID))
+	}
+	token := hex.EncodeToString(raw[:])
+	p.permissionMu.Lock()
+	if p.permissionTokens == nil {
+		p.permissionTokens = make(map[string]permissionToken)
+	}
+	cutoff := time.Now().Add(-30 * time.Minute)
+	for key, value := range p.permissionTokens {
+		if value.createdAt.Before(cutoff) {
+			delete(p.permissionTokens, key)
+		}
+	}
+	// A session can have only one pending permission request. Once a newer
+	// request is rendered, older cards must not remain capable of answering a
+	// reused ACP request id after an agent restart. Keep tokens for other QQ
+	// sessions, but invalidate every earlier card for this exact session.
+	for key, value := range p.permissionTokens {
+		if value.sessionKey == sessionKey {
+			delete(p.permissionTokens, key)
+		}
+	}
+	var userOpenID, groupOpenID, chatType string
+	if len(contexts) > 0 && contexts[0] != nil {
+		userOpenID, groupOpenID, chatType = contexts[0].userOpenID, contexts[0].groupOpenID, contexts[0].messageType
+	}
+	p.permissionTokens[token] = permissionToken{sessionKey: sessionKey, requestID: requestID,
+		userOpenID: userOpenID, groupOpenID: groupOpenID, chatType: chatType, createdAt: time.Now()}
+	p.permissionMu.Unlock()
+	return token
+}
+
+func (p *Platform) takePermissionToken(token string, actor ...string) *permissionToken {
+	p.permissionMu.Lock()
+	value, ok := p.permissionTokens[token]
+	if !ok || value.createdAt.Before(time.Now().Add(-30*time.Minute)) {
+		p.permissionMu.Unlock()
+		return nil
+	}
+	if len(actor) >= 3 && ((value.userOpenID != "" && value.userOpenID != actor[0]) ||
+		(value.groupOpenID != "" && value.groupOpenID != actor[1]) ||
+		(value.chatType != "" && value.chatType != actor[2])) {
+		p.permissionMu.Unlock()
+		return nil
+	}
+	delete(p.permissionTokens, token)
+	p.permissionMu.Unlock()
+	return &value
+}
