new file mode 100644
index 0000000..9ee65db
--- /dev/null
+++ b/platform/qqbot/permission_token_test.go
@@ -0,0 +1,102 @@
+package qqbot
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/chenhg5/cc-connect/core"
+)
+
+func interactionPayload(id, user, buttonData string) []byte {
+	payload := map[string]any{
+		"id": id, "user_openid": user, "chat_type": 2,
+		"data": map[string]any{"type": 11, "resolved": map[string]any{"button_data": buttonData}},
+	}
+	data, _ := json.Marshal(payload)
+	return data
+}
+
+func TestPermissionButtonBindsExactRequestAndConsumesToken(t *testing.T) {
+	p := &Platform{allowFrom: "allowed-user"}
+	p.permissionStrict.Store(true)
+	token := p.newPermissionToken("qqbot:allowed-user", "request-new")
+	var got *core.Message
+	p.handler = func(_ core.Platform, msg *core.Message) { got = msg }
+
+	p.handleInteractionCreate(interactionPayload("interaction-1", "allowed-user", "perm:allow:"+token))
+	if got == nil || got.PermissionRequestID != "request-new" || got.SessionKey != "qqbot:allowed-user" {
+		t.Fatalf("permission callback lost request binding: %#v", got)
+	}
+	got = nil
+	p.handleInteractionCreate(interactionPayload("interaction-2", "allowed-user", "perm:allow:"+token))
+	if got != nil {
+		t.Fatal("one-time permission token was reusable")
+	}
+}
+
+func TestNewPermissionRequestInvalidatesOlderCardForSameSession(t *testing.T) {
+	p := &Platform{allowFrom: "allowed-user"}
+	p.permissionStrict.Store(true)
+	old := p.newPermissionToken("qqbot:allowed-user", "request-old")
+	newToken := p.newPermissionToken("qqbot:allowed-user", "request-new")
+	if old == newToken {
+		t.Fatal("permission tokens unexpectedly reused")
+	}
+	if got := p.takePermissionToken(old, "allowed-user", "", "c2c"); got != nil {
+		t.Fatal("older permission card remained valid after a newer request")
+	}
+	if got := p.takePermissionToken(newToken, "allowed-user", "", "c2c"); got == nil || got.requestID != "request-new" {
+		t.Fatalf("new permission card was not retained: %#v", got)
+	}
+}
+
+func TestPermissionButtonRejectsUnauthorizedAndLegacyAfterStrictMode(t *testing.T) {
+	p := &Platform{allowFrom: "allowed-user,other-user"}
+	p.permissionStrict.Store(true)
+	token := p.newPermissionToken("qqbot:allowed-user", "request-new", &replyContext{messageType: "c2c", userOpenID: "allowed-user"})
+	called := false
+	p.handler = func(_ core.Platform, _ *core.Message) { called = true }
+	p.handleInteractionCreate(interactionPayload("interaction-wrong-actor", "other-user", "perm:allow:"+token))
+	if called {
+		t.Fatal("actor-mismatched button interaction reached the engine")
+	}
+	// The rejected actor must not consume the token; the bound actor can still
+	// use the same card exactly once.
+	p.handleInteractionCreate(interactionPayload("interaction-authorized", "allowed-user", "perm:allow:"+token))
+	if !called {
+		t.Fatal("authorized actor could not use an unconsumed permission token")
+	}
+	called = false
+	p.handleInteractionCreate(interactionPayload("interaction-legacy", "allowed-user", "perm:allow:qqbot:allowed-user"))
+	if called {
+		t.Fatal("legacy session-only permission button reached strict mode")
+	}
+}
+
+func TestGroupMessagesAreIgnoredByPrivateChatAdapter(t *testing.T) {
+	p := &Platform{allowFrom: "*"}
+	called := false
+	p.handler = func(_ core.Platform, _ *core.Message) { called = true }
+	p.handleDispatch("GROUP_AT_MESSAGE_CREATE", []byte(`{"id":"group-message","group_openid":"group","content":"绑定","author":{"member_openid":"user"}}`))
+	if called {
+		t.Fatal("group message reached the private-chat adapter")
+	}
+}
+
+func TestControlFooterPreservesAsyncQuestionRouting(t *testing.T) {
+	content := "异步问题提醒\n\n异步问题对话：00000000-0000-7000-8000-000000000001\n提问编号：call_test"
+	want := "异步问题对话：00000000-0000-7000-8000-000000000001\n提问编号：call_test"
+	if got := controlFooter(content); got != want {
+		t.Fatalf("controlFooter() = %q, want %q", got, want)
+	}
+}
+
+func TestC2CMessagesWithoutUserIdentityAreIgnored(t *testing.T) {
+	p := &Platform{allowFrom: "*"}
+	called := false
+	p.handler = func(_ core.Platform, _ *core.Message) { called = true }
+	p.handleC2CMessage([]byte(`{"id":"message-without-user","content":"绑定","author":{}}`))
+	if called {
+		t.Fatal("c2c message without an author identity reached the engine")
+	}
+}
