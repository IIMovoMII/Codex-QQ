+package acp
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"testing"
+
+	"github.com/chenhg5/cc-connect/core"
+)
+
+func TestControlMetadataReachesACPWithoutEnteringPrompt(t *testing.T) {
+	rResp, wResp := io.Pipe()
+	rReq, wReq := io.Pipe()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	defer rResp.Close()
+	defer wResp.Close()
+	defer rReq.Close()
+	defer wReq.Close()
+	tr := newTransport(rResp, wReq, nil, nil)
+	go tr.readLoop(ctx)
+	seen := make(chan map[string]any, 1)
+	go func() {
+		scan := bufio.NewScanner(rReq)
+		if scan.Scan() {
+			var req map[string]any
+			_ = json.Unmarshal(scan.Bytes(), &req)
+			seen <- req
+			_, _ = fmt.Fprintf(wResp, "{\"jsonrpc\":\"2.0\",\"id\":%v,\"result\":{\"stopReason\":\"end_turn\"}}\n", req["id"])
+		}
+	}()
+	s := &acpSession{ctx: ctx, tr: tr, events: make(chan core.Event, 2), acpSessID: "test"}
+	s.alive.Store(true)
+	err := s.SendWithMetadata("正文", "event-1", nil, nil, &core.InboundMetadata{
+		Version: 1, MessageID: "event-1", SentAtMs: 12345, Text: "继续😀", QuotedText: "旧卡片"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	req := <-seen
+	p := req["params"].(map[string]any)
+	m := p["_meta"].(map[string]any)["cc_connect"].(map[string]any)
+	if m["message_id"] != "event-1" || m["text"] != "继续😀" || m["sent_at_ms"] != float64(12345) {
+		t.Fatalf("lost transport metadata: %#v", m)
+	}
+	if p["prompt"].([]any)[0].(map[string]any)["text"] != "正文" {
+		t.Fatal("transport metadata was inserted into model text")
+	}
+}
