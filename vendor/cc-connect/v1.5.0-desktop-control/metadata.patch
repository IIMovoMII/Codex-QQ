+
+func TestMetadataDispatchPreservesQueuedEventIdentity(t *testing.T) {
+	s := &metadataProbeSession{}
+	m := &InboundMetadata{MessageID: "same-platform-event", SentAtMs: 12345, Text: "继续"}
+	queued := queuedMessage{messageID: m.MessageID, inboundMetadata: m}
+	if err := sendAgentWithMetadata(s, "normalized prompt", queued.messageID, nil, nil, queued.inboundMetadata); err != nil {
+		t.Fatal(err)
+	}
+	if s.seen != m || s.seen.MessageID != "same-platform-event" || s.seen.SentAtMs != 12345 {
+		t.Fatal("queued message lost original platform identity")
+	}
+	if err := sendAgentWithMetadata(&stubAgentSession{}, "normal", "id", nil, nil, nil); err != nil {
+		t.Fatal(err)
+	}
