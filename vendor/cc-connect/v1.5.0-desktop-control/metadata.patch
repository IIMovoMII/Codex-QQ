+package core
+
+// InboundMetadata is optional transport metadata for deterministic local control
+// adapters. It is not inserted into model prompts or ordinary platform replies.
+type InboundMetadata struct {
+	Version             int    `json:"version"`
+	Platform            string `json:"platform"`
+	SessionKey          string `json:"session_key"`
+	UserID              string `json:"user_id"`
+	MessageID           string `json:"message_id"`
+	SentAtMs            int64  `json:"sent_at_ms"`
+	ConnectionReadyAtMs int64  `json:"connection_ready_at_ms"`
+	Text                string `json:"text"`
+	QuotedText          string `json:"quoted_text,omitempty"`
+	QuotedMessageID     string `json:"quoted_message_id,omitempty"`
+}
+
+type MetadataAgentSession interface {
+	SendWithMetadata(string, string, []ImageAttachment, []FileAttachment, *InboundMetadata) error
+}
+
+func sendAgentWithMetadata(session AgentSession, prompt, messageID string, images []ImageAttachment, files []FileAttachment, metadata *InboundMetadata) error {
+	if adapter, ok := session.(MetadataAgentSession); ok && metadata != nil {
+		return adapter.SendWithMetadata(prompt, messageID, images, files, metadata)
+	}
+	return session.Send(prompt, messageID, images, files)
+}
