+
+func TestControlMetadataPreservesOriginalReplyAndPlatformTime(t *testing.T) {
+	m := controlMetadata("qqbot:test", "test", "unique", "2026-10-13T10:00:01.123Z",
+		"继续😀", "很久以前的对话卡片", &messageReference{MessageID: "old-quote"}, 12345)
+	if m.Text != "继续😀" || m.QuotedText != "很久以前的对话卡片" || m.QuotedMessageID != "old-quote" {
+		t.Fatalf("lost quotation boundary: %+v", m)
+	}
+	if m.MessageID != "unique" || m.SentAtMs != time.Date(2026, 10, 13, 10, 0, 1, 123000000, time.UTC).UnixMilli() || m.ConnectionReadyAtMs != 12345 {
+		t.Fatalf("lost original event identity: %+v", m)
+	}
+	bad := controlMetadata("qqbot:test", "test", "unique", "invalid", "继续", "", nil, 12345)
+	if bad.SentAtMs != 0 {
+		t.Fatal("unknown send time must not be replaced with receive time")
+	}
+}
