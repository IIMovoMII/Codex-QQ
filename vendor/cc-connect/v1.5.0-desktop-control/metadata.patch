+package qqbot
+
+import (
+	"time"
+
+	"github.com/chenhg5/cc-connect/core"
+)
+
+func controlMetadata(sessionKey, userID, messageID, timestamp, text, quote string, ref *messageReference, readyAt int64) *core.InboundMetadata {
+	m := &core.InboundMetadata{Version: 1, Platform: "qqbot", SessionKey: sessionKey,
+		UserID: userID, MessageID: messageID, Text: text, QuotedText: quote}
+	m.ConnectionReadyAtMs = readyAt
+	if sent, err := time.Parse(time.RFC3339Nano, timestamp); err == nil {
+		m.SentAtMs = sent.UnixMilli()
+	}
+	if ref != nil {
+		m.QuotedMessageID = ref.MessageID
+	}
+	return m
+}
