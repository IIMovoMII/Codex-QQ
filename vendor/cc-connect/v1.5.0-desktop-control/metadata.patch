+package qqbot
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestControlReferenceSurvivesLongBodyCacheEvictionAndRestart(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "cache.json")
+	p := &Platform{messageCachePath: path}
+	footer := "对话编号：00000000-0000-7000-8000-000000000001\n引用标识：abcdefghijkl"
+	p.cacheMessage("old-notification", strings.Repeat("正文😀", 1200)+"\n"+footer)
+	restarted := &Platform{messageCachePath: path}
+	got := restarted.resolveQuotedText(&messageReference{MessageID: "old-notification"})
+	if got != footer {
+		t.Fatalf("routing footer was truncated or lost: %q", got)
+	}
+	if strings.Contains(got, "正文") {
+		t.Fatal("historical full content persisted in control reference")
+	}
+}
