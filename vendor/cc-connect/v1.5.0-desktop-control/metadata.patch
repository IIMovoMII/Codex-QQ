+package qqbot
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+)
+
+var controlFooterLine = regexp.MustCompile(`^(对话编号：[A-Za-z0-9_-]{20,100}|引用标识：[A-Za-z0-9_-]{12})$`)
+
+// Only a routing footer is kept long term, not message content. Hash buckets
+// avoid loading all historical references into memory for an old quotation.
+func controlFooter(content string) string {
+	lines := strings.Split(strings.TrimSpace(content), "\n")
+	start := len(lines)
+	for start > 0 && controlFooterLine.MatchString(strings.TrimSpace(lines[start-1])) {
+		start--
+	}
+	if start == len(lines) {
+		return ""
+	}
+	return strings.Join(lines[start:], "\n")
+}
+
+func (p *Platform) controlReferencePath(id string) string {
+	hash := sha256.Sum256([]byte(id))
+	return filepath.Join(filepath.Dir(p.messageCachePath), "control-references", hex.EncodeToString(hash[:1])+".json")
+}
+
+func (p *Platform) controlReference(id string) string {
+	if p.messageCachePath == "" || id == "" {
+		return ""
+	}
+	data, err := os.ReadFile(p.controlReferencePath(id))
+	if err != nil {
+		return ""
+	}
+	var refs map[string]string
+	if json.Unmarshal(data, &refs) != nil {
+		return ""
+	}
+	return refs[id]
+}
+
+func (p *Platform) saveControlReference(id, content string) error {
+	footer := controlFooter(content)
+	if footer == "" || p.messageCachePath == "" {
+		return nil
+	}
+	path := p.controlReferencePath(id)
+	refs := map[string]string{}
+	if data, err := os.ReadFile(path); err == nil {
+		if err := json.Unmarshal(data, &refs); err != nil {
+			return err
+		}
+	} else if !os.IsNotExist(err) {
+		return err
+	}
+	refs[id] = footer
+	data, err := json.Marshal(refs)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return err
+	}
+	// cacheMessage serializes writes with messageCacheMu; consumers never read
+	// partial JSON because replacement is atomic on this same directory.
+	f, err := os.CreateTemp(filepath.Dir(path), ".reference-*.tmp")
+	if err != nil {
+		return err
+	}
+	tmp := f.Name()
+	defer os.Remove(tmp)
+	if _, err = f.Write(data); err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	return os.Rename(tmp, path)
+}
