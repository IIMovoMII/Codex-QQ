+
+func TestPassiveSequenceDoesNotResetDuringC2CReplyWindow(t *testing.T) {
+	p := &Platform{}
+	if p.nextMsgSeq("same-inbound-event") != 1 {
+		t.Fatal("first sequence")
+	}
+	p.msgSeqMap["same-inbound-event"].createdAt = time.Now().Add(-13 * time.Minute)
+	if got := p.nextMsgSeq("same-inbound-event"); got != 2 {
+		t.Fatalf("sequence reused after five minutes: got %d, want 2", got)
+	}
+}
+
+func TestIndependentMessageOmitsPassiveFieldsAndPreservesInboundContext(t *testing.T) {
+	var body map[string]any
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		_, _ = fmt.Fprint(w, `{"id":"accepted-id"}`)
+	}))
+	defer server.Close()
+	previousClient, previousURL := core.HTTPClient, apiBaseProduction
+	core.HTTPClient, apiBaseProduction = server.Client(), server.URL
+	t.Cleanup(func() { core.HTTPClient, apiBaseProduction = previousClient, previousURL })
+	p := &Platform{token: "test-token", tokenExpiry: time.Now().Add(time.Hour)}
+	incoming := &replyContext{messageType: "c2c", userOpenID: "user", eventMsgID: "old-event", sessionKey: "qqbot:user"}
+	active, err := p.ProactiveReplyContext(incoming)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = p.Send(context.Background(), active, "quota notification"); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := body["msg_id"]; ok {
+		t.Fatal("independent notification has passive msg_id")
+	}
+	if _, ok := body["msg_seq"]; ok {
+		t.Fatal("independent notification has passive sequence")
+	}
+	if incoming.eventMsgID != "old-event" {
+		t.Fatal("incoming context changed")
+	}
+	if err = p.Reply(context.Background(), incoming, "immediate reply"); err != nil {
+		t.Fatal(err)
+	}
+	if body["msg_id"] != "old-event" || body["msg_seq"] != float64(1) {
+		t.Fatal("regular reply lost its inbound identity")
+	}
+}
+
+func TestIndependentMessageClearsPassiveContextForGroup(t *testing.T) {
+	p := &Platform{}
+	incoming := &replyContext{messageType: "group", eventMsgID: "old-group-event", sessionKey: "qqbot:group"}
+	active, err := p.ProactiveReplyContext(incoming)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := active.(*replyContext)
+	if got.eventMsgID != "" {
+		t.Fatalf("group proactive context retained passive event id %q", got.eventMsgID)
+	}
+	if incoming.eventMsgID != "old-group-event" {
+		t.Fatal("group inbound context changed")
+	}
+}
+
+func TestMessageAcceptanceRequiresIDAndRejectsBusinessError(t *testing.T) {
+	for _, raw := range []string{`{}`, `{"code":40054005,"id":"fake-id"}`} {
+		t.Run(raw, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { _, _ = fmt.Fprint(w, raw) }))
+			defer server.Close()
+			previousClient, previousURL := core.HTTPClient, apiBaseProduction
+			core.HTTPClient, apiBaseProduction = server.Client(), server.URL
+			t.Cleanup(func() { core.HTTPClient, apiBaseProduction = previousClient, previousURL })
+			p := &Platform{token: "test-token", tokenExpiry: time.Now().Add(time.Hour)}
+			if err := p.Send(context.Background(), &replyContext{messageType: "c2c", userOpenID: "user"}, "alert"); err == nil {
+				t.Fatal("accepted error/empty receipt")
+			}
+		})
+	}
+}
