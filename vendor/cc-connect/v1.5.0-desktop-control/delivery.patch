+package core
+
+// ProactiveContextProvider separates an independent outbound send from an
+// immediate reply to an inbound event. Optional, to preserve other platforms.
+type ProactiveContextProvider interface {
+	ProactiveReplyContext(replyCtx any) (any, error)
+}
