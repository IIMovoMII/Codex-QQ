@@ -0,0 +1,27 @@
+package qqbot
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+)
+
+// Independent sends must not reuse an inbound event's finite reply window or
+// reply sequence. Clone the context so regular inbound replies are untouched.
+func (p *Platform) ProactiveReplyContext(value any) (any, error) {
+	original, ok := value.(*replyContext)
+	if !ok || original == nil {
+		return nil, fmt.Errorf("qqbot: invalid proactive context")
+	}
+	copy := *original
+	// Independent notifications must always be active messages. Reusing an
+	// inbound event ID would make delayed notifications look like passive
+	// replies and can leave them visible only as a phone notification.
+	copy.eventMsgID = ""
+	return &copy, nil
+}
+
+func deliveryHash(value string) string {
+	hash := sha256.Sum256([]byte(value))
+	return hex.EncodeToString(hash[:8])
+}
