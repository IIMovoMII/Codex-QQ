+package core
+
+import (
+	"context"
+	"fmt"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+type proactiveContextProbe struct {
+	stubPlatformEngine
+	lastContext any
+}
+
+func (p *proactiveContextProbe) ProactiveReplyContext(value any) (any, error) {
+	return "active-target", nil
+}
+
+func (p *proactiveContextProbe) Send(ctx context.Context, value any, content string) error {
+	p.lastContext = value
+	return p.stubPlatformEngine.Send(ctx, value, content)
+}
+
+func TestCUJ_P1_IndependentNotificationDoesNotReusePassiveReply(t *testing.T) {
+	p := &proactiveContextProbe{stubPlatformEngine: stubPlatformEngine{n: "test"}}
+	agent := &cujAgent{}
+	e := NewEngine("test", agent, []Platform{p}, filepath.Join(t.TempDir(), "sessions.json"), LangEnglish)
+	t.Cleanup(func() { _ = e.Stop() })
+	sendUser := func(id, text string) {
+		previous := len(p.getSent())
+		e.ReceiveMessage(p, &Message{SessionKey: "test:user", Platform: "test", MessageID: id,
+			UserID: "user", Content: text, ReplyCtx: "passive:" + id})
+		deadline := time.Now().Add(2 * time.Second)
+		for time.Now().Before(deadline) {
+			if len(p.getSent()) > previous {
+				return
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+		t.Fatalf("user reply not observed: %s", fmt.Sprint(p.getSent()))
+	}
+	sendUser("user-event-1", "first request")
+	sendUser("user-event-2", "second request")
+	if err := e.SendToSessionWithOptions("test:user", "independent quota alert", nil, nil, SendOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	if p.lastContext != "active-target" {
+		t.Fatalf("independent alert reused stale incoming context: %v", p.lastContext)
+	}
+	e.interactiveMu.Lock()
+	state := e.interactiveStates["test:user"]
+	e.interactiveMu.Unlock()
+	state.mu.Lock()
+	context := state.replyCtx
+	state.mu.Unlock()
+	if context != "passive:user-event-2" {
+		t.Fatalf("inbound reply context was modified: %v", context)
+	}
+}
